{
  "name": "mr-huang-agent",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Mr.Huang Agent 工作台前端（工程骨架）",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify:dev": "node scripts/verify-dev.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dompurify": "^3.4.16",
    "iconv-lite": "^0.7.3",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.2",
    "pdf-parse": "^2.4.5",
    "pinia": "^3.0.3",
    "playwright-core": "^1.63.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "wait-on": "^9.1.0"
  }
}
